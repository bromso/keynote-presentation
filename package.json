{
  "name": "keynote-presentation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@open-slide/core": "^2.0.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "dev": "bun run --filter deck dev",
    "build": "bun run --filter deck build",
    "preview": "bun run --filter deck preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck && bun run build",
    "render:clay": "bun run --filter @keynote/clay-ball render",
    "sync:skills": "bun run --filter deck sync:skills",
    "skills:restore": "bunx skills experimental_install -y"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "catalog:"
  }
}
